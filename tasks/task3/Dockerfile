# Використовуємо офіційний легкий образ Node.js
FROM node:18-alpine

# Встановлюємо робочу директорію всередині контейнера
WORKDIR /usr/src/app

# Копіюємо файли конфігурації (щоб кешувати встановлення модулів)
COPY package*.json ./

# Встановлюємо залежності
RUN npm install

# Копіюємо весь код проєкту в контейнер
COPY . .

# Відкриваємо порт, на якому працює наш сервер
EXPOSE 8080

# Команда для запуску
CMD ["node", "server.js"]